version: '3.8'

services:
  noctua-frontend:
    build:
      context: ./source/noctua-frontend
      dockerfile: Dockerfile
    ports:
      - "3000:80"
    restart: unless-stopped
    depends_on:
      noctua-backend:
        condition: service_healthy

  noctua-backend:
    build:
      context: ./source/noctua-backend
      dockerfile: Dockerfile
      target: runtime
    ports:
      - "8000:8080"
    restart: unless-stopped
    environment:
      - MYSQL_URL=${DB_URL}
      - MYSQL_USER=${DB_USER}
      - MYSQL_PASSWORD=${DB_PASSWORD}
      - JWT_SECRET=${JWT_SECRET}
      - GOOGLE_API_KEY=${GOOGLE_API_KEY}
      - SPRING_MAIL_HOST=${SPRING_MAIL_HOST}
      - SPRING_MAIL_PORT=${SPRING_MAIL_PORT}
      - SPRING_MAIL_USERNAME=${SPRING_MAIL_USERNAME}
      - SPRING_MAIL_PASSWORD=${SPRING_MAIL_PASSWORD}
      - MANAGEMENT_HEALTH_MAIL_ENABLED=false
    depends_on:
      noctua-mysql:
        condition: service_healthy
    healthcheck:
      test: [ "CMD-SHELL", "wget -qO- http://localhost:8080/actuator/health || exit 1" ]
      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 40s

  noctua-mysql:
    image: mysql:8.0
    container_name: noctua-mysql
    restart: unless-stopped
    ports:
      - "3307:3306"
    environment:
      MYSQL_ROOT_PASSWORD: ${DB_ROOT_PASSWORD}
      MYSQL_DATABASE: noctua
      MYSQL_USER: ${DB_USER}
      MYSQL_PASSWORD: ${DB_PASSWORD}
    volumes:
      - noctua-mysql-data:/var/lib/mysql
    healthcheck:
      test: [ "CMD-SHELL", "mysql -h 127.0.0.1 -u$$MYSQL_USER -p$$MYSQL_PASSWORD -e 'SELECT 1' $$MYSQL_DATABASE 2>/dev/null" ]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 60s

volumes:
  noctua-mysql-data:

